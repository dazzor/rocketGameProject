#include <SPI.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include "bmpheader.h"

#define SCREEN_WIDTH 128 // OLED display width, in pixels
#define SCREEN_HEIGHT 64 // OLED display height, in pixels
#define OLED_RESET     -1 // Reset pin # (or -1 if sharing Arduino reset pin)
#define SCREEN_ADDRESS 0x3C ///< See datasheet for Address; 0x3D for 128x64, 0x3C for 128x32
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

const int BUTT1 = 0;
const int BUTT2 = 14;
const int BUTT3 = 12;
const int BUTT4 = 13;

int x = SCREEN_WIDTH-ROCKET_WIDTH;
int y = (SCREEN_HEIGHT-ROCKET_HEIGHT) / 2;
int enemyx = 0;
int enemyy = 0;
bool enemyleft = true;
bool enemyup = true;

bool debouncebutt = false;
bool bullet[10] = {0};
int bx[10] = {0};
int by[10] = {0};
int bullet_counter = 0;

const int maxRadius = 10;
int xEnd = 0;
int yEnd = 0;
int prevEx = 0;
int prevEy = 0;
bool hit = false;
int radius = 1;
int ehit = 0;

void setup() {
  Serial.begin(115200);

  pinMode(BUTT1, INPUT);
  pinMode(BUTT2, INPUT);
  pinMode(BUTT3, INPUT);
  pinMode(BUTT4, INPUT);

  if(!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    Serial.println(F("SSD1306 allocation failed"));
    for(;;); // Don't proceed, loop forever
  }
}

void loop() {
  display.clearDisplay();

  if(digitalRead(BUTT1) == 0 && y>-ROCKET_HEIGHT/2) { y--; }
  if(digitalRead(BUTT2) == 0 && y<SCREEN_HEIGHT-ROCKET_HEIGHT/2) { y++; }
  if(digitalRead(BUTT3) == 0){} // for future use
  if(digitalRead(BUTT4) == 0) {
    loadingButt();
  } else debouncebutt = false;

  display.drawBitmap( x, y, rocket, ROCKET_WIDTH, ROCKET_HEIGHT, WHITE);

  if(!hit){
    display.drawBitmap( enemyx, enemyy, enemy, ENEMY_W, ENEMY_H, WHITE);
    checkCollision();
    moveEnemy();
  } else {
    explosion();
  }

  shootingButt();
  display.display();
}

void explosion() {
  for (int angle = 0; angle < 360; angle += 45) {
    xEnd = prevEx + radius * cos(radians(angle));
    yEnd = prevEy + radius * sin(radians(angle));
    display.drawPixel(xEnd, yEnd, WHITE);
  }
  radius++;
  if(radius >= maxRadius) {
    hit = false;
    radius = 1;
  }
}

void checkCollision(){
  for(int i=0;i<10;i++){
    if(bullet[i] == true)
      if(bx[i]>enemyx && bx[i]<enemyx+ENEMY_W/2 && by[i]>enemyy && by[i]<enemyy+ENEMY_H){
        bullet[i]=false;
        hit = true;
        prevEx = enemyx;
        prevEy = enemyy;
        enemyx = 0-ENEMY_W*2;
        enemyy=random(SCREEN_HEIGHT);
      }
  }
}

void moveEnemy() {
  if(enemyleft == true && enemyx < SCREEN_WIDTH/4) {enemyx++;}
  if(enemyx >= SCREEN_WIDTH/4) {enemyleft = false;}
  if(enemyleft == false && enemyx > 0-ENEMY_W*2) {enemyx--;}
  if(enemyx <= 0-ENEMY_W*2) {
    enemyy=random(SCREEN_HEIGHT);
    enemyleft = true;
  }

  if(enemyup == true && enemyy >0){enemyy--;}
  if(enemyy <= 0) {enemyup = false;}
  if(enemyup == false && enemyy < SCREEN_HEIGHT) {enemyy++;}
  if(enemyy >= SCREEN_HEIGHT) {enemyup = true;}
}

void loadingButt(){
    //Serial.println("LOADING");
    if(debouncebutt == false){
      debouncebutt = true;
      bullet[bullet_counter] = true;
      bx[bullet_counter] = x;
      by[bullet_counter] = y + ROCKET_HEIGHT/2;
      bullet_counter++;
      if(bullet_counter == 10) bullet_counter = 0;
    }
}

void shootingButt(){
  //Serial.println("SHOOTIING");
  for(int i=0; i<10; i++) {
    if(bullet[i] == true){
      bx[i]=bx[i]-4;
      if(bx[i]>0){
        display.drawCircle(bx[i], by[i], 1, WHITE);
      } else {bullet[i]=false;}
    }
  }
}
